(footprint "SW_ES_EG1218"
  (version 20240108)
  (generator pcbnew)
  (descr "E-Switch EG1218 compact SPDT slide switch; used as an SPST battery on/off switch")
  (tags "E-Switch EG1218 SPDT slide switch THT")
  (attr through_hole)
  (fp_rect
    (start -5.8 -2.0)
    (end 5.8 2.0)
    (stroke (width 0.12) (type solid))
    (fill none)
    (layer "F.SilkS"))
  (fp_rect
    (start -6.05 -2.25)
    (end 6.05 2.25)
    (stroke (width 0.05) (type solid))
    (fill none)
    (layer "F.CrtYd"))
  (fp_text reference "REF**"
    (at 0 -3.1)
    (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "SW_ES_EG1218"
    (at 0 3.1)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "COM"
    (at 0 1.25)
    (layer "F.SilkS")
    (effects (font (size 0.75 0.75) (thickness 0.12))))
  (fp_line (start -5.8 -2.0) (end 5.8 -2.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start 5.8 -2.0) (end 5.8 2.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start 5.8 2.0) (end -5.8 2.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start -5.8 2.0) (end -5.8 -2.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (pad "1" thru_hole rect
    (at -2.5 0)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle
    (at 0 0)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle
    (at 2.5 0)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/libraries/3dmodels/EG1218_slide_switch.wrl"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0)))
)
